rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'REPLACE_WITH_YOUR_ADMIN_EMAIL';
    }
    match /movies/{movieId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
